{
    "name": "bengal-studio/ai-sdk",
    "description": "AI SDK for PHP - A provider-agnostic toolkit for building AI-powered applications, inspired by Vercel's AI SDK.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "ai",
        "sdk",
        "llm",
        "openai",
        "anthropic",
        "google",
        "embedding",
        "streaming",
        "tools",
        "structured-output"
    ],
    "authors": [
        {
            "name": "Bengal Studio",
            "email": "hello@bengal.studio"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-client": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BengalStudio\\AI\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BengalStudio\\AI\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
